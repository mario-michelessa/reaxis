# Paths are resolved relative to the repository root unless absolute.
REAXIS_DATA_ROOT=data
REAXIS_DATASETS_ROOT=data/datasets
REAXIS_SESSIONS_ROOT=data/sessions
REAXIS_UPLOADS_ROOT=data/uploads
REAXIS_OUTPUT_ROOT=outputs
REAXIS_RAW_DATASETS_ROOT=data/raw
REAXIS_DATASYNTH_ROOT=data/raw
REAXIS_DEFAULT_DATASET=ISIC2017

# Backend process.
REAXIS_BACKEND_HOST=0.0.0.0
REAXIS_BACKEND_PORT=5001
REAXIS_FLASK_DEBUG=true

# LLM provider: gemini_api or huggingface_local.
REAXIS_LLM_PROVIDER=gemini_api
REAXIS_GEMINI_MODEL=gemini-2.5-flash-lite
REAXIS_GEMINI_API_KEY_FILE=data/secrets/gemini_api_key.txt
REAXIS_HF_MODEL_PATH=

# Vite development server.
CONDA_ENV=scaledit
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5174
FRONTEND_USE_POLLING=true
FRONTEND_POLL_INTERVAL_MS=400
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5001
VITE_API_BASE=/api
